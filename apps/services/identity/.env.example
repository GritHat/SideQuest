NODE_ENV=development
PORT=3000
# Matches the postgres service in compose.yaml (repository root)
DATABASE_URL=postgresql://sidequest:sidequest@localhost:5433/sidequest_identity

JWT_PRIVATE_KEY_FILE=keys/private.pem
JWT_KEY_ID=sidequest-dev-1
JWT_ISSUER=sidequest-identity
JWT_AUDIENCE=sidequest-api

# Email verification: the link points to this page (SPA route), which POSTs the token back.
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
# Password reset: the link points to this page (SPA route), which POSTs token + new password back.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Leave SMTP_URL empty to write emails (and their links) to the log: no external service needed.
SMTP_URL=
MAIL_FROM=SideQuest <no-reply@sidequest.local>

TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
