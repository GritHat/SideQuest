NODE_ENV=development
PORT=3000
# Matches the postgres service in compose.yaml (repository root)
DATABASE_URL=postgresql://sidequest:sidequest@localhost:5433/sidequest_identity

JWT_PRIVATE_KEY_FILE=keys/private.pem
JWT_KEY_ID=sidequest-dev-1
JWT_ISSUER=sidequest-identity
JWT_AUDIENCE=sidequest-api

TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
